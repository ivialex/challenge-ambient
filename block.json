      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "palette-classic" } } }
    },

    {
      "id": 104,
      "title": "Cost by System",
      "type": "piechart",
      "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "RestrictedAzureCostData_EnrollmentLevel\n| where TimeGenerated >= datetime(${__from:date}) and TimeGenerated <= datetime(${__to:date})\n| where MeterCategory contains \"Cosmos DB\"\n| summarize TotalCost = sum(CostInBillingCurrency) by ResourceGroup\n| project ResourceGroup, TotalCost\n| sort by TotalCost desc\n| limit 10",
          "format": "table",
