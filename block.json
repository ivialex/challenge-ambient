{
  "id": 200,
  "title": "Cosmos DB Cost Analysis",
  "type": "row",
  "collapsed": false,
  "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 100
  },
  "panels": [
    {
      "id": 101,
      "title": "Cost by Subscription",
      "type": "piechart",
      "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "RestrictedAzureCostData_EnrollmentLevel\n| where TimeGenerated >= datetime(${__from:date}) and TimeGenerated <= datetime(${__to:date})\n| where MeterCategory contains \"Cosmos DB\"\n| summarize TotalCost = sum(CostInBillingCurrency) by SubscriptionName\n| project SubscriptionName, TotalCost\n| sort by TotalCost desc\n| limit 10",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "pie",
        "legend": { "displayMode": "list", "placement": "right", "values": ["lastNotNull", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "palette-classic" } } }
    },

    {
      "id": 102,
      "title": "Cost by Region",
      "type": "piechart",
      "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "RestrictedAzureCostData_EnrollmentLevel\n| where TimeGenerated >= datetime(${__from:date}) and TimeGenerated <= datetime(${__to:date})\n| where MeterCategory contains \"Cosmos DB\"\n| summarize TotalCost = sum(CostInBillingCurrency) by ResourceLocation\n| project ResourceLocation, TotalCost\n| sort by TotalCost desc\n| limit 10",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "pie",
        "legend": { "displayMode": "list", "placement": "right", "values": ["lastNotNull", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "palette-classic" } } }
    },

    {
      "id": 103,
      "title": "Cost by API Type",
      "type": "piechart",
      "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "grafana-azure-data-explorer-datasource", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "RestrictedAzureCostData_EnrollmentLevel\n| where TimeGenerated >= datetime(${__from:date}) and TimeGenerated <= datetime(${__to:date})\n| where MeterCategory contains \"Cosmos DB\"\n| summarize TotalCost = sum(CostInBillingCurrency) by MeterSubCategory\n| project MeterSubCategory, TotalCost\n| sort by TotalCost desc\n| limit 10",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "pie",
        "legend": { "displayMode": "list", "placement": "right", "values": ["lastNotNull", "percent"] },
        "tooltip": { "mode": "single" }
